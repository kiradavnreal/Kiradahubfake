local function createTextBox(n,p,h)
	local t=Instance.new("TextBox")
	t.Size=UDim2.new(0,130,0,45)
	t.Position=p
	t.BackgroundColor3=Color3.fromRGB(20,20,20)
	t.TextColor3=Color3.fromRGB(255,255,255)
