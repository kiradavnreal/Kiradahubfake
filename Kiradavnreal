local snowflakes={}

local function createSnowflake()
	local cam=workspace.CurrentCamera
	if not cam then return end
	local screenSize=cam.ViewportSize
	local s=Instance.new("ImageLabel")
	s.Size=UDim2.new(0,math.random(10,20),0,math.random(10,20))
	s.Position=UDim2.new(0,math.random(0,screenSize.X),0,math.random(-50,0))
	s.BackgroundTransparency=1
	s.Image="rbxassetid://241560853"
	s.ImageColor3=Color3.fromRGB(255,255,255)
	s.Rotation=math.random(-45,45)
	s.ZIndex=999
	s.Parent=snowContainer
	local speed=math.random(40,100)/10
	local sway=math.random(-30,30)
	local tween=TweenService:Create(s,TweenInfo.new(speed,Enum.EasingStyle.Linear),{
		Position=UDim2.new(0,s.Position.X.Offset+sway,1,0),
		ImageTransparency=1,
		Rotation=s.Rotation+math.random(-90,90)
	})
	tween:Play()
	tween.Completed:Connect(function()
		if s and s.Parent then s:Destroy()end
		table.remove(snowflakes,table.find(snowflakes,s))
	end)
	table.insert(snowflakes,s)
end

local function startSnow()
	if snowConnection then return end
	snowContainer.Visible=true
	for i=1,25 do task.spawn(createSnowflake)end
	snowConnection=RunService.Heartbeat:Connect(function()
		if #snowflakes<25 then task.spawn(createSnowflake)end
	end)
end

local function stopSnow()
	if snowConnection then snowConnection:Disconnect() snowConnection=nil end
	snowContainer.Visible=false
	for _,s in pairs(snowflakes)do if s and s.Parent then s:Destroy()end end
	snowflakes={}
end

